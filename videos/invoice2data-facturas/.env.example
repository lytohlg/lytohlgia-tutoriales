# Plantilla de variables de este material — @lytohlgIA
# ---------------------------------------------------------------------------
# invoice2data no necesita ninguna clave: lee ficheros PDF que ya tienes en tu
# disco y escribe en tu disco. Este fichero existe para que puedas cambiar las
# rutas sin tocar el script.
#
# Se copia a .env (que NO se sube al repositorio) y la demo lo lee sola.

# Carpeta con las facturas que hay que leer (la crea el paso 0).
I2D_ENTRADA=entrada

# Carpeta con las plantillas YAML: una por formato de factura.
I2D_PLANTILLAS=plantillas

# Carpeta con la plantilla corregida del proveedor nuevo.
I2D_CORREGIDAS=plantillas_corregidas

# Motor de extracción de texto del PDF (pdfminer es el que trae invoice2data).
I2D_MOTOR=pdfminer

# Nombre base de las dos salidas: <salida>.csv y <todas>.csv.
I2D_SALIDA=salida
I2D_TODAS=todas

# Carpeta donde se archivan las facturas ya leídas.
I2D_ARCHIVO=procesadas
