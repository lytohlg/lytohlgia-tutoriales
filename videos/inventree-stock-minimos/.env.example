# Copia este fichero a .env (demo.sh lo hace solo la primera vez).
# Son los valores del entorno de pruebas: no hay ninguna credencial real aquí.
INVENTREE_URL=http://127.0.0.1:8000
INVENTREE_SITE_URL=http://127.0.0.1:8000
INVENTREE_SECRET_KEY=clave-de-entorno-de-pruebas
# La base de datos la sitúa scripts/arrancar.sh dentro del propio directorio de la demo;
# no se configura aquí para que al mover la carpeta no quede apuntando a otro sitio.
