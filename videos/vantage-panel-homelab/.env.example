# Variables que usa la demo. Ninguna es un secreto: la clave maestra se genera
# en el propio script con /dev/urandom y la base de datos es un SQLite temporal.
#
# Ruta del fichero con la clave maestra (32 bytes en base64). Obligatoria.
VANTAGE_MASTER_KEY_FILE=/tmp/clave.key
# Conexión de la base de datos. En la demo, un SQLite dentro del directorio de trabajo.
VANTAGE_DATABASE_URL=sqlite:////tmp/vantage.db
# Dirección privada que se prueba en el paso 6. Opcional: si no se define, el script
# compone una puerta de enlace de ejemplo. Debe estar en un rango privado (RFC 1918).
# LAN_IP=tu.router.local
