# Variables de entorno que leen los scripts (todas OPCIONALES).
# Cópialo a .env y ajusta lo que necesites; sin este fichero, los valores por
# defecto de abajo son los que usa la demo.

# Dónde vive el registro de experimentos. Por defecto: un fichero SQLite en la
# carpeta desde la que ejecutas (por eso la demo lo borra y lo recrea cada vez).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Dónde se guardan los artefactos (el modelo serializado de cada prueba).
# Por defecto: la carpeta mlartifacts junto al script.
MLFLOW_ARTIFACT_ROOT=file://./mlartifacts
