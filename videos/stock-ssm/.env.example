# Copia este fichero a .env y rellena los valores.
# NO subas nunca tu .env: contiene tus claves.
#
# Los valores de aquí son de DEMOSTRACIÓN: sirven para levantar la aplicación en tu máquina
# con datos de mentira. Si vas a usarla de verdad, cámbialos todos.

# --- Aplicación (Simple Stock Management) -------------------------------------------------
DJANGO_SECRET_KEY=demo-local-cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=db.sqlite3
ALLOW_PW_CHANGE=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
LOG_FILE=ssm.log

# Avisos por correo: en la demo se apagan (todo se queda en consola).
MAIL_SERVICE_BACKEND=django.core.mail.backends.dummy.EmailBackend
MAIL_SERVICE_API_KEY=
MAIL_SERVICE_API_URL=
MAIL_DEFAULT_FROM=
MAIL_SERVER_EMAIL=

# --- Usuarios de la demo (los crea el paso 2 de demo.sh) -----------------------------------
DEMO_USUARIO_ALMACEN=almacen
DEMO_USUARIO_TIENDA=tienda
DEMO_ALMACEN_CLAVE=demo-almacen-local
DEMO_TIENDA_CLAVE=demo-tienda-local

# --- Regla de aviso (la usa scripts/avisos_stock.py) ---------------------------------------
AVISO_MINIMO=10
AVISO_API=http://127.0.0.1:8000
